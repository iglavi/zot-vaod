# ===== Claude Managed Agent =====
# מפתח ה-API שלך מ-platform.claude.com (Settings -> API Keys)
ANTHROPIC_API_KEY=sk-ant-...

# מתקבלים פעם אחת מהרצת "npm run setup:agent" (ראה README)
AGENT_ID=agent_...
ENVIRONMENT_ID=env_...

# ===== וואטסאפ =====
# מספר הטלפון שאיתו הבוט יתחבר לוואטסאפ, בפורמט בינלאומי וללא סימנים (למשל 972501234567)
WHATSAPP_PHONE_NUMBER=9725XXXXXXX

# השם שאליו הבוט מגיב בקבוצה (ברירת מחדל: ליצי)
BOT_NAME=ליצי

# ===== בטיחות =====
# רשימה לבנה של מזהי קבוצות מורשות, מופרדים בפסיקים. דוגמה: 120363012345678901@g.us,120363019876543210@g.us
# את המזהה של קבוצה תראה בלוגים של הבוט בפעם הראשונה שהוא רואה הודעה ממנה.
ALLOWED_CHAT_IDS=

# ===== אחסון =====
# תיקייה שבה נשמרים קבצי ההתחברות לוואטסאפ ונתוני הבוט (session mapping, תזכורות).
# ב-Railway יש להצביע לתיקייה בתוך ה-Volume, למשל /data
DATA_DIR=./data

# אזור זמן לתזכורות
TIMEZONE=Asia/Jerusalem

# כמה הודעות "רקע" (שלא הופנו לבוט) לשמור לכל קבוצה בזיכרון, לצורך הקשר לסיכומים
MESSAGE_BUFFER_SIZE=200

# ===== דוא"ל (יכולת send_email של ליצי) =====
# הכתובת שממנה ליצי שולח/ת מיילים, וגם הנמען עבור התווית "me" בכלי send_email
GMAIL_ADDRESS=you@gmail.com
# App Password של Gmail (לא הסיסמה הרגילה!) - Google Account -> Security -> App passwords
# (דורש שיהיה מופעל אימות דו-שלבי בחשבון)
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# הכתובת עבור התווית "shani" בכלי send_email
SHANI_EMAIL=shani@example.com

# ===== סוכן "חבר" (שיחה פרטית/DM, נפרד לגמרי מליצי) =====
# ה-Agent/Environment הקיימים של סוכן "חבר" (לא נוצרים אוטומטית - צריך שכבר יהיו קיימים)
FRIEND_AGENT_ID=agent_...
FRIEND_ENVIRONMENT_ID=env_...
# שם תצוגה (לא חובה לשנות)
FRIEND_BOT_NAME=חבר
# אבטחה קריטית: המספר היחיד שמורשה לפתוח שיחה פרטית עם הסוכן הזה. פורמט בינלאומי
# בלי סימנים (כמו WHATSAPP_PHONE_NUMBER). כל הודעה פרטית ממספר אחר - מתעלמים לגמרי.
FRIEND_ALLOWED_NUMBER=9725XXXXXXX
